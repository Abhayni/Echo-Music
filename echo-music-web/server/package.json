{
  "name": "echo-music-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run src"
  },
  "dependencies": {
    "express": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
